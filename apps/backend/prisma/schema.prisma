/// *
///  * Hamkor (bus/rent_car yoki hotel-turi) taklif qilgan vaqtinchalik chegirma
///  * — xona (`hotel_rooms`) yoki mashina (`vehicles`) narxiga. Ilgari bu
///  * butunlay frontend mock edi (`web-partner/promotions.ts`dagi `let
///  * mockPromotions = []` — faqat brauzer xotirasida, admin tomoni esa 2 ta
///  * qattiq yozilgan (hardcoded) soxta yozuv qaytarardi; ikkalasi bir-biriga
///  * ulanmagan edi).
///  *
///  * `entityType`/`entityId` — `MediaFile.ownerType`/`ownerId` bilan bir xil
///  * polimorfik naqsh (haqiqiy FK emas, chunki "room" va "vehicle" ikki
///  * mutlaqo boshqa jadval) — `entityType` qiymatlari frontend bilan bir xil:
///  * "room" | "vehicle".
///  *
///  * `entityName` — frontendning o'zi hisoblab yuboradigan ko'rsatiladigan
///  * nom (masalan "Xona: 101" yoki "01A123AA (Cobalt)") — qayta hisoblash
///  * shart emas, admin jadvali buni to'g'ridan-to'g'ri ko'rsatadi.
///  *
///  * `status` qiymatlari — AYNAN web-partner/web-admin UI kutgan uchta holat
///  * (`pending_review`/`published`/`rejected`) — `HotelStatus`dagi bir xil
///  * so'zlar, lekin ALOHIDA enum (bu loyihada har bir domen o'z status
///  * enumiga ega — qarang `ReviewStatus`, `RefundStatus`, ...).
///  *
///  * `reviewedAt`/`reviewedBy` — `Hotel.reviewedAt`/`reviewedBy` bilan bir
///  * xil naqsh (real FK yo'q, faqat audit uchun UUID).
model Promotion {
  id                    String          @id @default(uuid()) @db.Uuid
  partnerOrganizationId String          @map("partner_organization_id") @db.Uuid
  entityType            String          @map("entity_type") @db.VarChar(32)
  entityId              String          @map("entity_id") @db.Uuid
  entityName            String          @map("entity_name") @db.VarChar(255)
  oldPriceSum           Decimal         @map("old_price_sum") @db.Decimal(18, 2)
  newPriceSum           Decimal         @map("new_price_sum") @db.Decimal(18, 2)
  discountPercent       Int             @map("discount_percent")
  startDate             DateTime        @map("start_date") @db.Date
  endDate               DateTime        @map("end_date") @db.Date
  status                PromotionStatus @default(pending_review)
  reviewedAt            DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy            String?         @map("reviewed_by") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id])

  @@index([partnerOrganizationId, status])
  @@index([status, createdAt])
  @@map("promotions")
}

/// *
///  * `address`/`latitude`/`longitude`/`nearbyPlaces`/`checkInTime`/
///  * `checkOutTime`/`cancellationPolicyCode`/`extraFees` deliberately mirror
///  * `Hotel`'s own fields (same types, same nullable/default semantics) —
///  * Transport (bus/rent_car) partners edit "Joylashuv"/"Ijara qoidalari"
///  * through the same UI shape as lodging partners, just backed by this table
///  * instead of `hotels`. Previously these columns did not exist at all, so
///  * the partner-submitted values were silently discarded (see migration
///  * 20260924120000_bus_company_transport_fields). All new columns are
///  * NULLABLE or carry a default so every pre-existing row stays valid.
///  * No `cancellationPolicyId` FK (unlike `Hotel`) — only the `_code` field
///  * was requested/needed for Transport.
model BusCompany {
  id                     String              @id @default(uuid()) @db.Uuid
  partnerOrganizationId  String              @map("partner_organization_id") @db.Uuid
  name                   String              @db.VarChar(255)
  status                 String              @default("active") @db.VarChar(32)
  ratingAverage          Decimal             @default(0) @map("rating_average") @db.Decimal(3, 2)
  reviewsCount           Int                 @default(0) @map("reviews_count")
  address                String?
  latitude               Decimal?            @db.Decimal(10, 7)
  longitude              Decimal?            @db.Decimal(10, 7)
  nearbyPlaces           Json                @default("[]") @map("nearby_places")
  checkInTime            String?             @map("check_in_time") @db.VarChar(5)
  checkOutTime           String?             @map("check_out_time") @db.VarChar(5)
  cancellationPolicyCode String              @default("MODERATE") @map("cancellation_policy_code") @db.VarChar(32)
  extraFees              Json                @default("[]") @map("extra_fees")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  partner                PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id])
  trips                  Trip[]
  vehicles               Vehicle[]
  translations           BusCompanyTranslation[]

  @@index([partnerOrganizationId, status])
  @@index([status, createdAt])
  @@map("bus_companies")
}

