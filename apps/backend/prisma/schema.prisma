  guestPhone                  String?                @map("guest_phone") @db.VarChar(20)
  termsAcceptedAt             DateTime?              @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion                String?                @map("terms_version") @db.VarChar(64)
  roomId                      String?                @map("room_id") @db.Uuid
  checkIn                     DateTime?              @map("check_in") @db.Date
  checkOut                    DateTime?              @map("check_out") @db.Date
  slotTime                    DateTime?              @map("slot_time") @db.Time(6)
  vehicleId                   String?                @map("vehicle_id") @db.Uuid
  messages                    BookingMessage[]
  history                     BookingStatusHistory[]
  hotel                       Hotel?                 @relation(fields: [hotelId], references: [id])
  partner                     PartnerOrganization    @relation(fields: [partnerOrganizationId], references: [id])
  room                        HotelRoom?             @relation(fields: [roomId], references: [id], onUpdate: NoAction)
