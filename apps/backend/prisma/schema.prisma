generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  firstName              String?                     @map("first_name") @db.VarChar(100)
  lastName               String?                     @map("last_name") @db.VarChar(100)
  phone                  String?                     @unique @db.VarChar(20)
  email                  String?                     @unique @db.VarChar(255)
  status                 UserStatus                  @default(unverified)
  preferredLanguage      Language                    @default(uz) @map("preferred_language")
  blockedReason          String?                     @map("blocked_reason")
  bookingBlockedUntil    DateTime?                   @map("booking_blocked_until") @db.Timestamptz(6)
  bookingBlockedReason   String?                     @map("booking_blocked_reason") @db.VarChar(255)
  phoneVerifiedAt        DateTime?                   @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt            DateTime?                   @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  emailVerifiedAt        DateTime?                   @map("email_verified_at") @db.Timestamptz(6)
  termsAcceptedAt        DateTime?                   @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion           String?                     @map("terms_version") @db.VarChar(64)
  passwordHash           String?                     @map("password_hash") @db.VarChar
  bonusBalance           Decimal?                    @default(0) @map("bonus_balance") @db.Decimal
  avatarMediaId          String?                     @map("avatar_media_id") @db.Uuid
  analyticsEvents        AnalyticsEvent[]
  sessions               AuthSession[]
  bookings               Booking[]
  bookingPenalties       BookingPenalty[]
  chatRooms              ChatRoom[]
  favorites              Favorite[]
  notifications          Notification[]
  reviews                Review[]
  supportTickets         SupportTicket[]
  bonusLedger            UserBonusLedgerEntry[]
  deletionRequests       UserDeletionRequest[]
  notificationPreference UserNotificationPreference?
  socialAccounts         UserSocialAccount[]
  media_files            MediaFile?                  @relation(fields: [avatarMediaId], references: [id])

  @@index([status, createdAt])
  @@index([deletedAt, createdAt])
  @@map("users")
}

model UserSocialAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  providerEmail  String?  @map("provider_email") @db.VarChar(255)
  emailVerified  Boolean  @default(false) @map("email_verified")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_social_accounts")
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  actorType          String    @map("actor_type") @db.VarChar(32)
  actorId            String    @map("actor_id") @db.Uuid
  refreshHash        String    @map("refresh_hash") @db.VarChar(255)
  familyId           String    @map("family_id") @db.Uuid
  ipAddress          String?   @map("ip_address") @db.VarChar(64)
  userAgent          String?   @map("user_agent")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshJti         String?   @map("refresh_jti") @db.VarChar(128)
  replacedByJti      String?   @map("replaced_by_jti") @db.VarChar(128)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(6)
  user               User?     @relation(fields: [userId], references: [id])

  @@index([actorType, actorId])
  @@index([familyId])
  @@map("auth_sessions")
}

model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String    @db.VarChar(20)
  purpose    String    @db.VarChar(40)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose, expiresAt])
  @@map("otp_challenges")
}

model UserNotificationPreference {
  userId    String   @id @map("user_id") @db.Uuid
  sms       Boolean  @default(true)
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  inApp     Boolean  @default(true) @map("in_app")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model UserBonusLedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_bonus_ledger")
}

model UserDeletionRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  status     String    @default("requested") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_deletion_requests")
}

model PartnerOrganization {
  id                    String                   @id @default(uuid()) @db.Uuid
  type                  PartnerOrganizationType
  legalName             String                   @map("legal_name") @db.VarChar(255)
  brandName             String                   @map("brand_name") @db.VarChar(255)
  taxId                 String?                  @unique @map("tax_id") @db.VarChar(32)
  phone                 String                   @db.VarChar(20)
  email                 String                   @db.VarChar(255)
  cityId                String                   @map("city_id") @db.Uuid
  address               String?
  status                PartnerStatus            @default(draft)
  defaultCommissionRate Decimal                  @default(12.00) @map("default_commission_rate") @db.Decimal(5, 2)
  approvedBy            String?                  @map("approved_by") @db.Uuid
  approvedAt            DateTime?                @map("approved_at") @db.Timestamptz(6)
  rejectionReason       String?                  @map("rejection_reason")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  logoUrl               String?                  @map("logo_url")
  showcase              Boolean                  @default(false)
  contactPerson         String?                  @map("contact_person") @db.VarChar(255)
  bookings              Booking[]
  busCompanies          BusCompany[]
  hotels                Hotel[]
  apiKeys               PartnerApiKey[]
  documents             PartnerDocument[]
  ledgerEntries         PartnerLedgerEntry[]
  city                  City                     @relation(fields: [cityId], references: [id])
  partnerUsers          PartnerUser[]
  webhooks              PartnerWebhookEndpoint[]
  promotions            Promotion[]

  @@index([status])
  @@index([cityId, status])
  @@index([status, createdAt])
  @@map("partner_organizations")
}

model PartnerUser {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  email          String              @db.VarChar(255)
  passwordHash   String              @map("password_hash") @db.VarChar(255)
  fullName       String?             @map("full_name") @db.VarChar(255)
  status         String              @default("active") @db.VarChar(32)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(6)
  role           String              @default("operator") @db.VarChar(64)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewReplies  Review[]

  @@unique([organizationId, email])
  @@index([email])
  @@map("partner_users")
}

model PartnerDocument {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  type           String              @db.VarChar(64)
  fileId         String?             @map("file_id") @db.Uuid
  status         String              @default("uploaded") @db.VarChar(32)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("partner_documents")
}

model AdminUser {
  id            String              @id @default(uuid()) @db.Uuid
  email         String              @unique @db.VarChar(255)
  passwordHash  String              @map("password_hash") @db.VarChar(255)
  fullName      String?             @map("full_name") @db.VarChar(255)
  role          String              @db.VarChar(64)
  status        String              @default("active") @db.VarChar(32)
  totpSecret    String?             @map("totp_secret") @db.VarChar(255)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(6)
  recoveryCodes AdminRecoveryCode[]
  settings      AdminSetting[]      @relation("AdminSettingUpdatedBy")

  @@index([deletedAt, createdAt])
  @@map("admin_users")
}

model AdminSetting {
  groupKey       String     @id @map("group_key") @db.VarChar(80)
  value          Json       @default("{}")
  updatedBy      String?    @map("updated_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByAdmin AdminUser? @relation("AdminSettingUpdatedBy", fields: [updatedBy], references: [id], onUpdate: NoAction)

  @@index([updatedAt])
  @@map("admin_settings")
}

model AdminRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([adminId, usedAt])
  @@map("admin_recovery_codes")
}

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cities    City[]

  @@map("regions")
}

model City {
  id          String                @id @default(uuid()) @db.Uuid
  regionId    String                @map("region_id") @db.Uuid
  name        Json
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  slug        String?               @unique @db.VarChar(255)
  imageUrl    String?               @map("image_url")
  sortOrder   Int                   @default(0) @map("sort_order")
  attractions Attraction[]
  region      Region                @relation(fields: [regionId], references: [id])
  hotels      Hotel[]
  partners    PartnerOrganization[]
  routesFrom  Route[]               @relation("RouteFromCity")
  routesTo    Route[]               @relation("RouteToCity")
  tripStops   TripStop[]
  tripsFrom   Trip[]                @relation("TripFromCity")
  tripsTo     Trip[]                @relation("TripToCity")

  @@index([regionId])
  @@map("cities")
}

model Attraction {
  id                       String             @id @default(uuid()) @db.Uuid
  cityId                   String             @map("city_id") @db.Uuid
  slug                     String             @unique @db.VarChar(255)
  title                    Json
  description              Json
  category                 AttractionCategory @default(historical)
  coverImageUrl            String?            @map("cover_image_url")
  galleryImages            Json               @default("[]") @map("gallery_images")
  latitude                 Decimal?           @db.Decimal(10, 7)
  longitude                Decimal?           @db.Decimal(10, 7)
  ticketPrice              Decimal?           @map("ticket_price") @db.Decimal(18, 2)
  openingHours             String?            @map("opening_hours") @db.VarChar(100)
  recommendedVisitDuration Int?               @map("recommended_visit_duration_minutes")
  ratingAverage            Decimal            @default(0) @map("rating_average") @db.Decimal(3, 2)
  reviewsCount             Int                @default(0) @map("reviews_count")
  isActive                 Boolean            @default(true) @map("is_active")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  city                     City               @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([category])
  @@index([isActive, ratingAverage])
  @@map("attractions")
}

model PromotionBanner {
  id                 String   @id @default(uuid()) @db.Uuid
  title              Json
  subtitle           Json?
  badgeText          String?  @map("badge_text") @db.VarChar(50)
  imageUrl           String   @map("image_url")
  targetUrl          String?  @map("target_url")
  discountPercentage Int?     @map("discount_percentage")
  startDate          DateTime @map("start_date") @db.Timestamptz(6)
  endDate            DateTime @map("end_date") @db.Timestamptz(6)
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("promotion_banners")
}

model HeroBackground {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page      String   @db.VarChar(64)
  title     Json?
  subtitle  Json?
  imageUrl  String   @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([page, isActive])
  @@index([isActive, sortOrder])
  @@map("hero_backgrounds")
}

model Amenity {
  id         String         @id @default(uuid()) @db.Uuid
  code       String         @unique @db.VarChar(80)
  name       Json
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  hotelLinks HotelAmenity[]
  roomLinks  RoomAmenity[]

  @@map("amenities")
}

model RoomType {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(80)
  name        Json
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  description String?
  imageUrl    String?     @map("image_url")
  bedType     String?     @map("bed_type") @db.VarChar(80)
  sizeSqm     Int?        @map("size_sqm")
  basePrice   Decimal?    @map("base_price") @db.Decimal(18, 2)
  capacity    Int?
  amenities   Json        @default("[]")
  rooms       HotelRoom[]

  @@map("room_types")
}

model MediaFile {
  id         String    @id @default(uuid()) @db.Uuid
  ownerType  String    @map("owner_type") @db.VarChar(32)
  ownerId    String    @map("owner_id") @db.Uuid
  bucket     String    @db.VarChar(100)
  objectKey  String    @map("object_key")
  url        String?
  mimeType   String    @map("mime_type") @db.VarChar(120)
  size       Int
  visibility String    @default("private") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  caption    String?
  category   String?   @db.VarChar(32)
  sortOrder  Int       @default(0) @map("sort_order")
  isCover    Boolean   @default(false) @map("is_cover")
  users      User[]

  @@index([ownerType, ownerId])
  @@index([ownerType, ownerId, sortOrder, createdAt], map: "media_files_hotel_order_idx")
  @@map("media_files")
}

model CancellationPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 Json
  rules                Json
  refundableUntilHours Int?     @map("refundable_until_hours")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  hotels               Hotel[]

  @@map("cancellation_policies")
}

model Hotel {
  id                     String              @id @default(uuid()) @db.Uuid
  partnerOrganizationId  String              @map("partner_organization_id") @db.Uuid
  slug                   String              @unique @db.VarChar(255)
  cityId                 String              @map("city_id") @db.Uuid
  address                String
  latitude               Decimal?            @db.Decimal(10, 7)
  longitude              Decimal?            @db.Decimal(10, 7)
  stars                  Int
  ratingAverage          Decimal             @default(0) @map("rating_average") @db.Decimal(3, 2)
  reviewsCount           Int                 @default(0) @map("reviews_count")
  status                 HotelStatus         @default(draft)
  checkInTime            String?             @map("check_in_time") @db.VarChar(5)
  checkOutTime           String?             @map("check_out_time") @db.VarChar(5)
  cancellationPolicyId   String?             @map("cancellation_policy_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)
  featured               Boolean             @default(false)
  // `featured` (holat) va `featuredOrder` (tartib) ATAYLAB ALOHIDA: bu NULL
  // bo'lishi mumkin bo'lgan, `featured=false` hotellar uchun mutlaqo
  // e'tiborga olinmaydigan tartib raqami. Faqat admin `POST
  // /admin/hotels/featured/reorder` orqali sozlaydi (admin.service.ts:
  // reorderFeaturedHotels) — hech qachon `featured` bilan bir vaqtda
  // implicit ravishda o'zgartirilmaydi.
  featuredOrder          Int?                @map("featured_order")
  cancellationPolicyCode String              @default("MODERATE") @map("cancellation_policy_code") @db.VarChar(32)
  smokingAllowed         Boolean             @default(false) @map("smoking_allowed")
  petsAllowed            Boolean             @default(false) @map("pets_allowed")
  childrenAllowed        Boolean             @default(true) @map("children_allowed")
  extraFees              Json                @default("[]") @map("extra_fees")
  rulesCompletedAt       DateTime?           @map("rules_completed_at") @db.Timestamptz(6)
  submittedAt            DateTime?           @map("submitted_at") @db.Timestamptz(6)
  reviewedAt             DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy             String?             @map("reviewed_by") @db.Uuid
  rejectionReason        String?             @map("rejection_reason")
  nextDraftPreparedAt    DateTime?           @map("next_draft_prepared_at") @db.Timestamptz(6)
  submittedBy            String?             @map("submitted_by") @db.Uuid
  nearbyPlaces           Json                @default("[]") @map("nearby_places")
  landAreaSotix          Int?                @map("land_area_sotix")
  hasOutdoorPool         Boolean             @default(false) @map("has_outdoor_pool")
  hasIndoorPool          Boolean             @default(false) @map("has_indoor_pool")
  hasSauna               Boolean             @default(false) @map("has_sauna")
  hasPlaystation         Boolean             @default(false) @map("has_playstation")
  hasBilliards           Boolean             @default(false) @map("has_billiards")
  capacityPeople         Int?                @map("capacity_people")
  medicalProfiles        Json                @default("[]") @map("medical_profiles")
  includedTreatments     Json                @default("[]") @map("included_treatments")
  mealPlanType           String?             @map("meal_plan_type") @db.VarChar(64)
  bookings               Booking[]
  amenities              HotelAmenity[]
  rooms                  HotelRoom[]
  translations           HotelTranslation[]
  cancellationPolicy     CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  city                   City                @relation(fields: [cityId], references: [id])
  partner                PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id])

  @@index([cityId, status])
  @@index([ratingAverage])
  @@index([partnerOrganizationId, status])
  @@index([status, createdAt])
  @@index([status, ratingAverage])
  @@index([status, stars])
  @@index([featured], where: raw("(featured = true)"))
  @@index([status, updatedAt(sort: Desc)])
  @@index([submittedBy], where: raw("(submitted_by IS NOT NULL)"))
  @@map("hotels")
}

model HotelTranslation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String   @map("hotel_id") @db.Uuid
  language         Language
  name             String   @db.VarChar(255)
  description      String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  shortDescription String?  @map("short_description")
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, language])
  @@map("hotel_translations")
}

model HotelAmenity {
  hotelId   String  @map("hotel_id") @db.Uuid
  amenityId String  @map("amenity_id") @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
  @@map("hotel_amenities")
}

model HotelRoom {
  id                 String                 @id @default(uuid()) @db.Uuid
  hotelId            String                 @map("hotel_id") @db.Uuid
  roomTypeId         String                 @map("room_type_id") @db.Uuid
  code               String                 @db.VarChar(50)
  baseOccupancy      Int                    @map("base_occupancy")
  maxAdults          Int                    @map("max_adults")
  maxChildren        Int                    @map("max_children")
  totalInventory     Int                    @map("total_inventory")
  basePrice          Decimal                @map("base_price") @db.Decimal(18, 2)
  status             RoomStatus             @default(active)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
