{
  "name": "safaar-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "turbo build",
    "build:types": "turbo build --filter=@safaar/types",
    "build:backend": "turbo build --filter=@safaar/backend",
    "build:user": "turbo build --filter=@safaar/web-user",
    "build:partner": "turbo build --filter=@safaar/web-partner",
    "build:admin": "turbo build --filter=@safaar/web-admin",
    "dev": "turbo dev",
    "dev:types": "turbo dev --filter=@safaar/types",
    "dev:backend": "pnpm --filter @safaar/backend run start:dev",
    "dev:user": "turbo dev --filter=@safaar/web-user",
    "dev:partner": "turbo dev --filter=@safaar/web-partner",
    "dev:admin": "turbo dev --filter=@safaar/web-admin",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:backend": "turbo test --filter=@safaar/backend",
    "format": "pnpm -r --if-present run format"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "vercel": "^61.1.0"
  }
}
