NODE_ENV=development
APP_NAME=safaar-api
PORT=4000
# Bare-metal/VM joylashuvda (nginx bir xil serverda) HOST=127.0.0.1 qo'ying —
# aks holda ilova porti internetdan to'g'ridan-to'g'ri ochiq qolib, nginx
# orqali ishlaydigan rate-limit/trust-proxy himoyasini chetlab o'tish mumkin
# bo'ladi. Docker-compose ortida ishlaydigan joylashuv uchun 0.0.0.0 qoldiring.
HOST=0.0.0.0
API_PREFIX=v1
APP_URL=http://localhost:4000
WEB_USER_URL=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:4000
UPLOADS_DIR=./uploads
BUSINESS_TIMEZONE=Asia/Tashkent

DATABASE_URL=postgresql://safaar:safaar@localhost:5432/safaar
REDIS_URL=redis://localhost:6379/0
QUEUE_REDIS_URL=redis://localhost:6379/1
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
DB_QUERY_ATTEMPTS=1
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=300
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=safaar-api
JWT_AUDIENCE=safaar-clients
OTP_PEPPER=change_me_min_32_chars
# OTP (SMS/email) kodi necha soniyada eskiradi. Juda uzoq TTL brute-force
# oynasini kengaytiradi — default 5 daqiqa production uchun mos.
OTP_TTL_SECONDS=300
TOTP_ENCRYPTION_KEY=change_me_min_32_chars
RECOVERY_CODE_PEPPER=change_me_min_32_chars
PARTNER_API_KEY_PEPPER=change_me_min_32_chars
PAYMENT_WEBHOOK_SECRET=change_me_min_32_chars

# true bo'lsa — real SMS/email provayder hali ulanmagan bosqichda ham OTP
# oqimini sinab ko'rish mumkin: kod haqiqiy SMS/email o'rniga javobda
# `dev_code` maydonida qaytariladi (frontend uni ko'rsatishi mumkin).
# XAVFSIZLIK: NODE_ENV=production bo'lsa bu bayroq ikki qatlamli himoya
# bilan majburan o'chirilgan — (1) `true` qilib qo'yilsa ilova ishga
# tushishning o'zidan bosh tortadi (env.validation.ts), (2) hatto shu
# tekshiruv negadir chetlab o'tilsa ham, kod runtime'da production'da
# `dev_code`ni hech qachon qaytarmaydi (auth.service.ts). Development/
# staging'dan tashqarida bu bayroqni yoqib bo'lmaydi.
ENABLE_DEMO_AUTH=false

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback
FACEBOOK_APP_ID=change_me
FACEBOOK_APP_SECRET=change_me
FACEBOOK_CALLBACK_URL=http://localhost:4000/v1/auth/facebook/callback

# `eskiz` yoki `textup` bo'lishi mumkin — tegishli quyidagi bo'limni to'ldiring.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=change_me
ESKIZ_PASSWORD=change_me
ESKIZ_FROM=safaar

TEXTUP_EMAIL=change_me
TEXTUP_PASSWORD=change_me
# TextUp hisobingizdagi userId (login javobidagi user.id) — /v1/send so'rovida majburiy.
TEXTUP_USER_ID=change_me
# Ixtiyoriy — TextUp tomonidan tasdiqlangan shablon ID (hozircha "Safaar"
# shabloni "in_verify" holatida, tasdiqlangach shu yerga qo'yiladi).
TEXTUP_TEMPLATE_ID=
# Ixtiyoriy — alfa-nom (nickname) ID; bo'sh qoldirilsa qisqa raqamdan yuboriladi.
TEXTUP_NICKNAME_ID=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@safaar.uz
SMTP_PASS=change_me
SMTP_FROM=safaar.uz <noreply@safaar.uz>

CLICK_SERVICE_ID=change_me
CLICK_MERCHANT_ID=change_me
CLICK_SECRET_KEY=change_me
PAYME_MERCHANT_ID=change_me
PAYME_KEY=change_me
UZCARD_MERCHANT_ID=change_me
UZCARD_SECRET_KEY=change_me
HUMO_MERCHANT_ID=change_me
HUMO_SECRET_KEY=change_me

# Uzum Merchant API (kiruvchi webhook: /check /create /confirm /reverse /status)
# Uzum tomonidan beriladi. Bo'sh bo'lsa Uzum webhooklari 10001 bilan rad etiladi.
UZUM_SERVICE_ID=change_me
UZUM_USERNAME=change_me
UZUM_PASSWORD=change_me

# Uzum CHECKOUT (Merchant API'dan MUTLAQO ALOHIDA — chiquvchi /payment/register
# + kiruvchi /v1/uzum/checkout/callback). Qiymatlar Uzum Checkout onboarding'dan
# keladi. Hech biri hozircha majburiy EMAS:
#  - BASE_URL/MERCHANT_ID/API_KEY bo'sh -> register/status/refund fail-closed;
#  - SIGNATURE_SCHEME 'none' (default) -> har qanday callback fail-closed rad etiladi.
# TERMINAL_ID va SIGNATURE_* nomlari rasmiy spec bilan tasdiqlanishi kerak.
UZUM_CHECKOUT_BASE_URL=
UZUM_CHECKOUT_MERCHANT_ID=
UZUM_CHECKOUT_TERMINAL_ID=
UZUM_CHECKOUT_API_KEY=
UZUM_CHECKOUT_CALLBACK_SIGN_KEY=
UZUM_CHECKOUT_SIGNATURE_HEADER=x-signature
UZUM_CHECKOUT_SIGNATURE_SCHEME=none
# IXTIYORIY. Sozlangan bo'lsa — FAQAT Uzum Checkout chiquvchi so'rovlari
# (register/getOrderStatus/getOperationState/refund) shu forward-proxy orqali
# chiqadi (statik chiquvchi IP kafolati — Uzum merchant allowlist uchun).
# Boshqa HECH BIR chiquvchi HTTP (SMS/email/CBU kurs/webhook/OAuth/...) bunga
# ta'sirlanmaydi — `setGlobalDispatcher` ISHLATILMAYDI. Bo'sh -> Uzum Checkout
# so'rovlari ham to'g'ridan-to'g'ri boradi. Sozlansa yaroqli http(s) URL
# bo'lishi SHART (aks holda ilova ishga tushmaydi). Credential FAQAT shu
# yerda (env), Git'ga commit qilinmaydi, logga userinfo yashirilgan holda
# chiqadi. Format: http://<user>:<parol>@<gateway-tailscale-ip>:3128
UZUM_CHECKOUT_HTTPS_PROXY=

CASH_PAYMENT_ENABLED=false
PARTNER_API_ENABLED=false
PARTNER_API_DEFAULT_RATE_LIMIT=60
PARTNER_WEBHOOK_SIGNING_SECRET=change_me

STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET_PUBLIC=
STORAGE_BUCKET_PRIVATE=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# XAVFSIZLIK: production'da true bo'lsa ilova ishga tushishdan bosh
# tortadi (to'liq API sxemasini autentifikatsiyasiz ochib qo'yadi).
SWAGGER_ENABLED=true
